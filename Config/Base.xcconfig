// Both targets use the installed macOS SDK. Validation host: macOS 26.6.2.
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
ARCHS = arm64
// Preserve the repository's compatibility floor; only the M4/Tahoe host is validated.
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
GCC_WARN_UNDECLARED_SELECTOR = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

CODE_SIGN_STYLE = Automatic
// Both targets must use the same Apple Development identity.
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_ENTITLEMENTS = Config/Helios.entitlements
// Trusted XPC peers must not be attachable/injectable by another local process.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
// Set a machine-specific Team ID in ignored Config/Local.xcconfig.
DEVELOPMENT_TEAM =

CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0
VERSIONING_SYSTEM = apple-generic
GENERATE_INFOPLIST_FILE = NO
COPY_PHASE_STRIP = NO

// Optional machine-local signing overrides.
#include? "Local.xcconfig"
